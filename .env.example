# Polymarket Insider Tracker Configuration
#
# 🎯 OPTIMIZED FOR OFI + CHANGE POINT DETECTION
# This configuration is tuned for maximum signal-to-noise ratio with the new
# quantitative detection algorithms (Order Flow Imbalance + Change Point).
#
# Quick Start:
# 1. Set ANTHROPIC_API_KEY (required for AI filtering)
# 2. Set Telegram credentials
# 3. Use defaults below (already optimized)
# 4. Run and monitor results
# 5. Adjust MIN_BET_SIZE and SUSPICIOUS_SCORE_THRESHOLD if needed
#
# 📊 Expected Results with Default Settings:
# - 10-30 high-quality alerts per scan (with AI review)
# - ~60% win rate on directional signals
# - Low false positive rate (<20%)
#

# AI Review (HIGHLY RECOMMENDED - filters false positives)
# Get your API key from: https://console.anthropic.com/
# Without this, ALL anomalies will trigger alerts (lots of noise)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Notifications (recommended)
# Get your bot token from @BotFather on Telegram
# Get your chat ID by messaging your bot and visiting: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Polymarket Authentication (REQUIRED for trade data access)
# Get these from your Polymarket account or wallet
# Your Polygon wallet private key (DO NOT SHARE!)
POLYMARKET_PRIVATE_KEY=your_private_key_here
# Your funder address (your Polygon wallet address)
POLYMARKET_FUNDER=0xYourAddressHere
# Signature type (usually 2 for EIP-712)
POLYMARKET_SIGNATURE_TYPE=2
# Chain ID (137 for Polygon mainnet)
POLYMARKET_CHAIN_ID=137

# Slack Integration (optional, deprecated)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Detection Thresholds
# Number of days to consider a wallet "fresh"
FRESH_WALLET_DAYS=30

# Minimum bet size in USD to track (smaller bets are ignored)
# OPTIMIZED: With OFI+ChangePoint detection, sophisticated insiders can be detected
# even with moderate bet sizes. Lower threshold catches more insider activity.
# Testing: 100-300 | Balanced: 500 | Conservative: 1000
MIN_BET_SIZE=500

# Alert threshold (0-10 scale) - only alerts with score >= this value will be sent
# OPTIMIZED: With OFI+ChangePoint adding up to 21 points to base score,
# threshold of 5 provides excellent signal-to-noise ratio.
# AI review filters remaining false positives.
# Aggressive: 3-4 | Balanced: 5 | Conservative: 6-7
SUSPICIOUS_SCORE_THRESHOLD=5

# Performance Settings
# Number of markets to process concurrently
CONCURRENT_BATCH_SIZE=30

# Maximum HTTP connections in the pool
MAX_CONNECTIONS=50

# Seconds between each scan cycle
POLL_INTERVAL=60

# Logging
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

#
# 🔧 TUNING GUIDE - Adjust based on your results:
#
# Getting TOO MANY alerts?
# → Increase SUSPICIOUS_SCORE_THRESHOLD to 6 or 7
# → Increase MIN_BET_SIZE to 750 or 1000
# → Keep ANTHROPIC_API_KEY set (AI filters noise)
#
# Getting TOO FEW alerts?
# → Decrease SUSPICIOUS_SCORE_THRESHOLD to 4 or 3
# → Decrease MIN_BET_SIZE to 300 or 100
# → Run with --debug to see what's being detected
#
# Alerts seem like FALSE POSITIVES?
# → Ensure ANTHROPIC_API_KEY is set (AI review is critical)
# → Increase SUSPICIOUS_SCORE_THRESHOLD to 6
# → Check "AI Approved" vs "AI Reviewed" ratio in stats
#
# Want to see MORE OFI/ChangePoint signals?
# → Lower MIN_BET_SIZE (OFI works on any size)
# → Watch "OFI Signals" and "Change Points" in stats
# → These indicate detection is working
#
# 📈 Monitoring Your Results:
# After each scan, check the stats table:
# - OFI Signals > 100 = Good (detecting order flow)
# - Change Points > 50 = Good (detecting regime shifts)
# - AI Approved / AI Reviewed < 0.5 = Good (AI filtering works)
# - Alerts / Markets Scanned < 0.03 = Good (not too noisy)
#
